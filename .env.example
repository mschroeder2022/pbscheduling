# ---- Picklr account (step 0 — working) ----
# All three locations share one login unless per-location overrides are set.
PICKLR_EMAIL=
PICKLR_PASSWORD=
PICKLR_SCOTTSDALENORTH_EMAIL=
PICKLR_SCOTTSDALENORTH_PASSWORD=
PICKLR_TEMPE_EMAIL=
PICKLR_TEMPE_PASSWORD=
PICKLR_MESA_EMAIL=
PICKLR_MESA_PASSWORD=

# ---- Microsoft Graph / calendar (step 1) ----
# Client ID from your Azure app registration (see docs/graph-setup.md).
AZURE_CLIENT_ID=
# 'consumers' for a personal outlook.com account; 'common' if the app also allows
# work/school accounts.
AZURE_AUTHORITY=consumers
# Space-separated delegated scopes. Reads use GRAPH_SCOPES; the Discord "Add to
# calendar" approval on a Picklr orphan reservation uses GRAPH_WRITE_SCOPES. `npm run
# auth` consents to the union of both.
GRAPH_SCOPES=Calendars.Read offline_access User.Read
GRAPH_WRITE_SCOPES=Calendars.ReadWrite offline_access User.Read
# The mailbox whose calendar we read.
CALENDAR_ACCOUNT=your-account@outlook.com

# How many days ahead the calendar sweep looks (tournament checks need ~1 month).
SYNC_WINDOW_DAYS=35

# ---- Discord (step 3) ----
DISCORD_BOT_TOKEN=
# The bot resolves the target channel by server + channel NAME (no IDs to look up).
DISCORD_GUILD_NAME=The Hive
DISCORD_CHANNEL_NAME=pb-scheduler
# Optional: pin exact IDs instead of names (takes precedence if set).
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
